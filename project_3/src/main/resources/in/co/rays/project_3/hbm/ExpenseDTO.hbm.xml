<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>

    <class name="in.co.rays.project_3.dto.ExpenseDTO" table="EXPENSEDTO">

        <id name="Id" type="java.lang.Long">
            <column name="ID"/>
            <generator class="increment"/>
        </id>

        <property name="expenseCode" type="java.lang.String">
            <column name="EXPENSECODE"/>
        </property>

        <property name="expenseType" type="java.lang.String">
            <column name="EXPENSETYPE"/>
        </property>

        <property name="amount" type="java.lang.String">
            <column name="AMOUNT"/>
        </property>

        <property name="expenseDate" type="java.util.Date">
            <column name="EXPENSEDATE"/>
        </property>

        <property name="expenseStatus" type="java.lang.String">
            <column name="EXPENSESTATUS"/>
        </property>

        <!-- ===== BaseDTO Common Fields ===== -->

        <property name="createdBy" type="java.lang.String" length="50">
            <column name="CREATED_BY"/>
        </property>

        <property name="modifiedBy" type="java.lang.String" length="50">
            <column name="MODIFIED_BY"/>
        </property>

        <property name="createdDatetime" type="java.sql.Timestamp">
            <column name="CREATED_DATETIME"/>
        </property>

        <property name="modifiedDatetime" type="java.sql.Timestamp">
            <column name="MODIFIED_DATETIME"/>
        </property>

    </class>

</hibernate-mapping>