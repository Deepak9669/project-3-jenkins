<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>

    <class name="in.co.rays.project_3.dto.DoctorDTO" table="DOCTORDTO">

        <id name="id" type="java.lang.Long">
            <column name="ID"/>
            <generator class="increment"/>
        </id>

        <property name="doctorName" type="java.lang.String">
            <column name="DOCTORNAME"/>
        </property>

        <property name="hospitalName" type="java.lang.String">
            <column name="HOSPITALNAME"/>
        </property>

        <property name="patientName" type="java.lang.String">
            <column name="PATIENTNAME"/>
        </property>

        <property name="diseases" type="java.lang.String">
            <column name="DISEASES"/>
        </property>

        <property name="appointmentDate" type="java.util.Date">
            <column name="APPOINTMENTDATE"/>
        </property>

        <!-- BaseDTO Fields -->

        <property name="createdBy" type="java.lang.String">
            <column name="CREATED_BY"/>
        </property>

        <property name="modifiedBy" type="java.lang.String">
            <column name="MODIFIED_BY"/>
        </property>

        <property name="createdDatetime" type="java.sql.Timestamp">
            <column name="CREATED_DATETIME"/>
        </property>

        <property name="modifiedDatetime" type="java.sql.Timestamp">
            <column name="MODIFIED_DATETIME"/>
        </property>

    </class>

</hibernate-mapping>
